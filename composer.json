{
  "name": "ernestdefoe/seo",
  "description": "SEO meta tags, OpenGraph, Twitter Cards, JSON-LD structured data, bundled sitemap.xml generator, and search-console verification for Flarum 2.",
  "keywords": ["flarum", "flarum-extension", "seo", "sitemap", "opengraph", "schema.org", "json-ld"],
  "type": "flarum-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "ernestdefoe",
      "email": "ernestdefoe@gmail.com"
    }
  ],
  "homepage": "https://github.com/ernestdefoe/seo",
  "support": {
    "issues": "https://github.com/ernestdefoe/seo/issues",
    "source": "https://github.com/ernestdefoe/seo"
  },
  "autoload": {
    "psr-4": {
      "Ernestdefoe\\Seo\\": "src/"
    }
  },
  "require": {
    "php": "^8.3",
    "flarum/core": "^2.0",
    "ext-json": "*"
  },
  "require-dev": {
    "flarum/tags": "^2.0",
    "fof/pages": "^2.0",
    "fof/best-answer": "^2.0",
    "flarum/phpstan": "^2.0"
  },
  "minimum-stability": "beta",
  "prefer-stable": true,
  "conflict": {
    "zerosonesfun/elint": "*",
    "franzl/flarum-open-links-in-new-tab": "*"
  },
  "suggest": {
    "fof/sitemap": "Allows you to generate powerful sitemap.xml files"
  },
  "extra": {
    "flarum-extension": {
      "title": "SEO for Flarum 2",
      "category": "feature",
      "optional-dependencies": [
        "flarum/tags",
        "ernestdefoe/og-image"
      ],
      "icon": {
        "name": "fas fa-check",
        "backgroundColor": "#0072ff",
        "color": "#ffffff"
      }
    }
  },
  "scripts": {
    "analyse:phpstan": "phpstan analyse",
    "clear-cache:phpstan": "phpstan clear-result-cache"
  }
}
